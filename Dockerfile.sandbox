# Dockerfile for AI Sandbox (Python Execution Environment)
FROM python:3.11-slim-bookworm

# Install system dependencies for financial analysis and tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages required for analysis
RUN pip install --no-cache-dir \
    pandas \
    numpy \
    matplotlib \
    requests \
    flask \
    statsmodels \
    scipy

# Security: Create non-root user
RUN useradd -m -u 1000 -s /bin/bash sandboxuser && \
    mkdir -p /sandbox /app && \
    chown -R sandboxuser:sandboxuser /sandbox /app

# Copy bridge script
COPY --chown=sandboxuser:sandboxuser server/scripts/sandbox-bridge.py /app/bridge.py

USER sandboxuser
WORKDIR /sandbox

EXPOSE 5000

CMD ["python", "/app/bridge.py"]
